# {{ ansible_managed }}
# Generated by the samba4_manager Ansible role. Local changes will be overwritten.

[app:main]
use = egg:samba4_manager

pyramid.reload_templates = false
pyramid.debug_authorization = false
pyramid.debug_notfound = false
pyramid.debug_routematch = false
pyramid.default_locale_name = en

samba4_manager.session_secret = {{ _s4m_session_secret }}
samba4_manager.auth_secret = {{ _s4m_auth_secret }}
# Apache serves the app over HTTPS only, so cookies are marked "secure".
samba4_manager.secure_cookies = true

[server:main]
use = egg:waitress#main
# Only reachable from this machine; Apache is the public entry point.
listen = 127.0.0.1:{{ samba4_manager_port }}
threads = {{ samba4_manager_threads }}
{% if _s4m_prefix %}
url_prefix = {{ _s4m_prefix }}
{% endif %}
# Trust the X-Forwarded-* headers set by Apache so generated URLs use https://
trusted_proxy = 127.0.0.1
trusted_proxy_count = 1
trusted_proxy_headers = x-forwarded-for x-forwarded-host x-forwarded-proto x-forwarded-port
clear_untrusted_proxy_headers = yes

[loggers]
keys = root, samba4_manager

[handlers]
keys = console

[formatters]
keys = generic

[logger_root]
level = {{ samba4_manager_log_level }}
handlers = console

[logger_samba4_manager]
level = {{ samba4_manager_log_level }}
handlers =
qualname = samba4_manager

[handler_console]
class = StreamHandler
args = (sys.stderr,)
level = NOTSET
formatter = generic

[formatter_generic]
format = %(levelname)-5.5s [%(name)s:%(lineno)s][%(threadName)s] %(message)s
