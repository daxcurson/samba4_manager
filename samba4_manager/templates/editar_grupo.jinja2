{% extends "base.jinja2" %}
{% block page_title %}Samba4 Manager - Edit group{%endblock%}
{% block breadcrumb_items %}
	{{ super() }}
    <li class="breadcrumb-item">
        <a href="{{ request.route_path('listar_grupos') }}">Grupos</a>
    </li>
{% endblock %}
{% block breadcrumb_active_item %}
            <li class="breadcrumb-item active">Editar Grupo</li>
{% endblock %}
{% block sidebar_groups %}active{% endblock %}
{% block content %}
{% for message in saved %}
<div class="alert alert-success" role="alert">{{ message }}</div>
{% endfor %}
{% if error %}
<div class="alert alert-danger" role="alert">{{ error }}</div>
{% endif %}
<form id="group-form" method="POST" action="{{ request.route_path('editar_grupo_mostrar_form', objectguid=grupo.objectguid) }}">
<input type="hidden" name="csrf_token" value="{{ request.session.get_csrf_token() }}">
<div class="form-group row">
	<div class="col-sm-2 col-form-label">Distinguished Name</div>
	<div class="col-sm-10"><input type="text" readonly class="form-control-plaintext" value="{{ grupo.dn }}"></div>
</div>
<div class="form-group row">
	<div class="col-sm-2 col-form-label">SamAccountName</div>
	<div class="col-sm-10"><input type="text" readonly class="form-control-plaintext" value="{{ grupo.samaccountname }}"></div>
</div>
<div class="form-group row">
	<div class="col-sm-2 col-form-label">Scope / Type</div>
	<div class="col-sm-10"><input type="text" readonly class="form-control-plaintext" value="{{ grupo.scope }} / {{ grupo.group_type }}"></div>
</div>
<div class="form-group row">
	{{ form.description.label(class="col-sm-2 col-form-label") }}
	<div class="col-sm-10">
		{{ form.description(class="form-control" + (" is-invalid" if form.description.errors else "")) }}
		{% for e in form.description.errors %}<div class="invalid-feedback">{{ e }}</div>{% endfor %}
	</div>
</div>
<div class="form-group row">
	<div class="col-sm-2 col-form-label">Members</div>
	<div class="col-sm-10">
		{% if form.remove_members.choices %}
		<table class="table table-sm table-bordered mb-1">
			<thead><tr><th>Member</th><th class="text-center" style="width: 6em">Remove</th></tr></thead>
			<tbody>
			{% for option in form.remove_members %}
				<tr>
					<td>{{ option.label(class="mb-0") }}</td>
					<td class="text-center">{{ option() }}</td>
				</tr>
			{% endfor %}
			</tbody>
		</table>
		{% else %}
		<p class="form-control-plaintext mb-1">This group has no members.</p>
		{% endif %}
		<small class="form-text text-muted">Accounts that have this group as their primary group (for example, everyone in Domain Users) are not listed.</small>
		{% for e in form.remove_members.errors %}<div class="text-danger small">{{ e }}</div>{% endfor %}
	</div>
</div>
<div class="form-group row">
	{{ form.add_member.label(class="col-sm-2 col-form-label") }}
	<div class="col-sm-10">
		{{ form.add_member(class="form-control" + (" is-invalid" if form.add_member.errors else ""), placeholder="e.g. jdoe") }}
		{% for e in form.add_member.errors %}<div class="invalid-feedback">{{ e }}</div>{% endfor %}
		<small class="form-text text-muted">{{ form.add_member.description }}</small>
	</div>
</div>
<div class="form-group row">
	<div class="col-sm-10 offset-sm-2">
		<button type="submit" class="btn btn-primary">Save</button>
		<a class="btn btn-secondary" href="{{ request.route_path('listar_grupos') }}">Back to groups</a>
	</div>
</div>
</form>
{% endblock %}
