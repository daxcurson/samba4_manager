{% extends "base.jinja2" %}
{% block page_title %}Samba4 Manager - Add organizational unit{%endblock%}
{% block breadcrumb_active_item %}
            <li class="breadcrumb-item active">Agregar Unidad Organizativa</li>
{% endblock %}
{% block sidebar_ous %}active{% endblock %}
{% block content %}
{% for message in saved %}
<div class="alert alert-success" role="alert">{{ message }}</div>
{% endfor %}
{% if error %}
<div class="alert alert-danger" role="alert">{{ error }}</div>
{% endif %}
<div class="row">
<div class="col-lg-7">
<form id="ou-form" method="POST" action="{{ request.route_path('agregar_ou_grabar_form') }}">
<input type="hidden" name="csrf_token" value="{{ request.session.get_csrf_token() }}">
<div class="form-group row">
	{{ form.name.label(class="col-sm-3 col-form-label") }}
	<div class="col-sm-9">
		{{ form.name(class="form-control" + (" is-invalid" if form.name.errors else ""), placeholder="e.g. Groups") }}
		{% for e in form.name.errors %}<div class="invalid-feedback">{{ e }}</div>{% endfor %}
	</div>
</div>
<div class="form-group row">
	{{ form.parent.label(class="col-sm-3 col-form-label") }}
	<div class="col-sm-9">
		{{ form.parent(class="form-control" + (" is-invalid" if form.parent.errors else "")) }}
		{% for e in form.parent.errors %}<div class="invalid-feedback">{{ e }}</div>{% endfor %}
		<small class="form-text text-muted">The top level of the domain, or inside another OU.</small>
	</div>
</div>
<div class="form-group row">
	{{ form.description.label(class="col-sm-3 col-form-label") }}
	<div class="col-sm-9">
		{{ form.description(class="form-control" + (" is-invalid" if form.description.errors else "")) }}
		{% for e in form.description.errors %}<div class="invalid-feedback">{{ e }}</div>{% endfor %}
	</div>
</div>
<div class="form-group row">
	<div class="col-sm-9 offset-sm-3">
		<button type="submit" class="btn btn-primary">Create OU</button>
	</div>
</div>
</form>
</div>
<div class="col-lg-5">
	<div class="card mb-3">
		<div class="card-header"><i class="fas fa-sitemap"></i> Existing organizational units</div>
		<ul class="list-group list-group-flush" id="ou-tree">
		{% for dn, label in form.parent.choices %}
			<li class="list-group-item py-1" title="{{ dn }}">{{ label }}</li>
		{% endfor %}
		</ul>
		<div class="card-footer small text-muted">New users and groups can be created in any of these OUs.</div>
	</div>
</div>
</div>
{% endblock %}
